{
  "name": "@sovorn/pi-job-search",
  "version": "0.1.0",
  "description": "Pi-native job search workflows",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "pi-package"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "tsx --test test/**/*.test.ts",
    "typecheck": "tsc --noEmit",
    "cli": "tsx src/cli.ts",
    "verify:package": "tsx scripts/verify-package.mjs",
    "verify:setup": "tsx scripts/verify-setup.mjs",
    "verify:scrape": "tsx scripts/verify-scrape.mjs",
    "verify:apply": "tsx scripts/verify-apply.mjs",
    "verify:outcome-interview": "tsx scripts/verify-outcome-interview.mjs"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  },
  "pi": {
    "extensions": [
      "./extensions"
    ],
    "skills": [
      "./skills"
    ],
    "prompts": [
      "./prompts"
    ]
  },
  "dependencies": {
    "cheerio": "^1.2.0",
    "fast-xml-parser": "^5.10.1"
  }
}
